{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/normarchy/catalog.schema.json",
  "title": "Normarchy production catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "generated_on", "verification", "items"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "catalog_version": {"type": "integer", "minimum": 1},
    "generated_on": {"type": "string", "format": "date"},
    "verification": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "url", "kind", "category", "source_tier",
        "enabled", "verified_on", "duration_seconds", "width", "height"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "url": {"type": "string", "format": "uri", "pattern": "^https://(www\\.)?(youtube\\.com|youtu\\.be)/"},
        "kind": {"enum": ["short", "clip", "source"]},
        "category": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "source_tier": {"enum": ["official", "archive", "fan"]},
        "source_channel_id": {"type": "string", "maxLength": 100},
        "source_channel": {"type": "string", "maxLength": 200},
        "enabled": {"type": "boolean"},
        "verified_on": {"type": "string", "format": "date"},
        "uploaded_on": {"type": "string", "format": "date"},
        "duration_seconds": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "start_seconds": {"type": "integer", "minimum": 0},
        "end_seconds": {"type": "integer", "minimum": 1},
        "notes": {"type": "string", "maxLength": 1000}
      }
    }
  }
}
